# Flowexa Environment Variables
DEBUG=True
SECRET_KEY=change-me-in-production-flowexa-secret-key-super-secure
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=flowexa_db
DB_USER=flowexa_user
DB_PASSWORD=flowexa_secure_password
DB_HOST=localhost
DB_PORT=5432
# Set USE_SQLITE=True for lightweight local dev/testing if PostgreSQL is not running
USE_SQLITE=False

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
