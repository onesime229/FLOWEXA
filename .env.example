# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SPRINT B16: Flowexa Payment Gateways & Webhooks Secrets
FLOWEXA_PAYMENT_WEBHOOK_SECRET=
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_SANDBOX=true
MTN_MOMO_API_KEY=
MTN_MOMO_API_URL=
MTN_MOMO_WEBHOOK_SECRET=
MOOV_MONEY_API_KEY=
MOOV_MONEY_API_URL=
MOOV_MONEY_WEBHOOK_SECRET=
CELTIS_CASH_API_KEY=
CELTIS_CASH_API_URL=
CELTIS_CASH_WEBHOOK_SECRET=
CARD_GATEWAY_API_KEY=
CARD_GATEWAY_API_URL=
CARD_GATEWAY_WEBHOOK_SECRET=

# SPRINT B30: Flowexa Communication Channels (Email, SMS, WhatsApp)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM="FLOWEXA <notifications@flowexa.com>"
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=
SMS_FROM="FLOWEXA"
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

